{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TubeDirector Engine",
  "version": "0.3.0",
  "identifier": "br.com.tubedirector.engine",
  "build": { "frontendDist": "../src" },
  "app": {
    "windows": [{"title": "TubeDirector Engine", "width": 980, "height": 690, "minWidth": 780, "minHeight": 570, "backgroundColor": "#070a1d"}],
    "withGlobalTauri": true,
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/bridge.py", "resources/bin/*"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.icns"],
    "shortDescription": "Motor local de narração do TubeDirector",
    "category": "Productivity"
  }
}
